{
  "name": "dsh-user-approval-mode",
  "version": "0.3.2",
  "description": "User approval modes plugin for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib/"],
  "scripts": {
    "build": "tsc && tsdown",
    "prepare": "npm run build"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@rh854lkjd/dsh-tool-list-dir": ">=0.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-sandbox": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-session": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-commands": ">=0.1.2-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.2",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-rc.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-sandbox": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-session": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-commands": ">=0.1.2-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.2",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-rc.1",
    "react": "^18.2.0",
    "@types/react": "~18.3.1",
    "typescript": "^5.0.0",
    "tsdown": "^0.22.14",
    "lightningcss": "^1.27.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
