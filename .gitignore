# Build outputs — `lib/` is deliberately NOT ignored: it is committed so that a
# GitHub install (`dsh plugin add github:R-LEI2536/dsh-user-approval-mode`) has
# its bundle on disk already and needs no build step on the user's machine.
# Rebuild it (`pnpm build`) and commit it in the same change as any src/ edit.
*.tsbuildinfo

# Environment / secrets — never commit
.env
.env.*
!.env.example

# Dependencies
node_modules/
# pnpm content-addressable store (paired with node_modules/.pnpm/)
.pnpm-store/

# Documentation
tutorial/

# Development notes (not for users)
local-docs/
ref_codes/
# ReMe local memory store (runtime cache, per-machine)
.reme/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Asset backups (keep only the final version in git)
assets/example.gif
